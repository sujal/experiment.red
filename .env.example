# YouTube Audio Downloader Configuration

# Directory where downloaded audio files will be saved
# Default: ~/Music/YouTube
YOUTUBE_MUSIC_DIR=~/Music/YouTube

# Browser to extract cookies from for YouTube Premium authentication
# Options: firefox, chrome, chromium, edge, safari, brave, opera, vivaldi, none
# Set to "none" to skip cookie authentication (useful if you don't have Premium or get permission errors)
# Default: firefox
BROWSER_FOR_COOKIES=firefox

# Artwork size (square dimension in pixels)
# Default: 1000
ARTWORK_SIZE=1000

# Audio quality (0 = best, 10 = worst)
# Default: 0
AUDIO_QUALITY=0
